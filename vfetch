#!/bin/bash

case "${1:-}" in
  -i|--install)
    self=$(realpath "$0" 2>/dev/null)
    [[ -z "$self" ]] && { self=$(cd "$(dirname "$0")" && pwd); self="${self}/$(basename "$0")"; }
    sudo install -m 755 "$self" /usr/local/bin/vfetch && echo "vfetch installed to /usr/local/bin/vfetch"
    exit 0
    ;;
  -u|--uninstall)
    sudo rm -f /usr/local/bin/vfetch && echo "vfetch uninstalled from /usr/local/bin"
    exit 0
    ;;
esac

NC=$(tput sgr0)
LBL=$(tput setaf 252)
AC=$(tput setaf 38)
BOX=$(tput setaf 245)
C_OS=$(tput setaf 39)
C_HW=$(tput setaf 38)
C_HOST=$(tput setaf 245)
C_CORE=$(tput setaf 208)
C_TIME=$(tput setaf 76)
C_PKG=$(tput setaf 141)
C_ENV=$(tput setaf 39)
C_DE=$(tput setaf 99)
C_CPU=$(tput setaf 208)
C_MEM=$(tput setaf 39)
C_GPU=$(tput setaf 141)
C_DISK=$(tput setaf 215)
C_BAT=$(tput setaf 76)
C_NET=$(tput setaf 38)
C_LOCALE=$(tput setaf 245)

TERM_WIDTH=$(tput cols)
LABEL_WIDTH=12
BOX_PAD=4
BOX_WIDTH=$((TERM_WIDTH - BOX_PAD))
CONTENT_W=$((BOX_WIDTH - 2))
VALUE_MAX=$((CONTENT_W - 16))
[[ $VALUE_MAX -lt 4 ]] && VALUE_MAX=4

BANNER='       ___    __      __ 
 _  __/ _/__ / /_____/ / 
| |/ / _/ -_) __/ __/ _ \
|___/_/ \__/\__/\__/_//_/
                         '

TMPD="${TMPDIR:-/tmp}/vfetch.$$"
mkdir -p "$TMPD"

(rpm -qa 2>/dev/null | wc -l) > "$TMPD/rpm" &
(flatpak list 2>/dev/null | wc -l) > "$TMPD/flatpak" &
(gnome-shell --version 2>/dev/null | grep -oP '[\d\.]+' || true) > "$TMPD/gnome" &
(lspci 2>/dev/null | grep -m1 -i 'vga\|3d\|display' | sed 's/.*: //' || true) > "$TMPD/gpu" &
(hostname -I 2>/dev/null | awk '{print $1}' || true) > "$TMPD/ip" &
if command -v wmctrl >/dev/null 2>&1; then
    (wmctrl -m 2>/dev/null | grep "Name:" | cut -d' ' -f2- || true) > "$TMPD/wm" &
else
    (xprop -root -notype _NET_WM_NAME 2>/dev/null | sed -e 's/^.*= "\(.*\)"$/\1/' || true) > "$TMPD/wm" &
fi

os=$(grep -o 'PRETTY_NAME=".*"' /etc/os-release 2>/dev/null | cut -d'"' -f2)
host=$(hostname)
kernel=$(uname -r)
uptime=$(uptime -p 2>/dev/null | sed 's/up //')
shell=$(basename "$SHELL")

de="$XDG_CURRENT_DESKTOP"
display_server="Unknown"
[[ -n "$WAYLAND_DISPLAY" ]] && display_server="Wayland"
[[ -n "$DISPLAY" && -z "$WAYLAND_DISPLAY" ]] && display_server="X11"

model="Unknown"
if [[ -f /sys/devices/virtual/dmi/id/product_name ]]; then
    product_name=$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null)
    product_version=$(cat /sys/devices/virtual/dmi/id/product_version 2>/dev/null)
    [[ -n "$product_name" ]] && model="$product_name"
    [[ -n "$product_version" ]] && model="$model $product_version"
elif [[ -f /sys/firmware/devicetree/base/model ]]; then
    model=$(cat /sys/firmware/devicetree/base/model 2>/dev/null)
fi

cpu_model=$(grep -m1 "model name" /proc/cpuinfo 2>/dev/null | cut -d':' -f2 | sed 's/^[ \t]*//')
cpu_cores=$(grep -c ^processor /proc/cpuinfo 2>/dev/null || echo 0)
cpu="$cpu_model ($cpu_cores)"

mem_info=$(grep -E 'MemTotal|MemAvailable' /proc/meminfo 2>/dev/null)
mem_total=$(echo "$mem_info" | grep MemTotal | awk '{print int($2/1024)}')
mem_available=$(echo "$mem_info" | grep MemAvailable | awk '{print int($2/1024)}')
mem_used=$((mem_total - mem_available))
memory="${mem_used}MB / ${mem_total}MB"

df_output=$(df -h / 2>/dev/null | awk 'NR==2{print $3"/"$2" ("$5")"}')
disk="$df_output"

battery="N/A"
if [[ -d /sys/class/power_supply/BAT0 ]]; then
    bat_status=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null)
    bat_percent=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null)
    [[ -n "$bat_percent" ]] && battery="$bat_percent% ($bat_status)"
fi

locale="${LANG:-}"

wait
rpm_count=$(cat "$TMPD/rpm" 2>/dev/null || echo 0)
flatpak_count=$(cat "$TMPD/flatpak" 2>/dev/null || echo 0)
packages="$rpm_count (rpm), $flatpak_count (flatpak)"

[[ "$de" == *"GNOME"* ]] && { gnome_version=$(cat "$TMPD/gnome" 2>/dev/null); [[ -n "$gnome_version" ]] && de="$de $gnome_version"; }

wm="Unknown"
if [[ "$XDG_CURRENT_DESKTOP" == *"GNOME"* ]]; then
    wm="Mutter"
elif [[ "$XDG_CURRENT_DESKTOP" == *"KDE"* ]]; then
    wm="KWin"
elif [[ "$XDG_CURRENT_DESKTOP" == *"Xfce"* ]]; then
    wm="Xfwm4"
else
    wm=$(cat "$TMPD/wm" 2>/dev/null)
    [[ -z "$wm" ]] && wm="Unknown"
fi

gpu=$(cat "$TMPD/gpu" 2>/dev/null)
local_ip=$(cat "$TMPD/ip" 2>/dev/null)
rm -rf "$TMPD"

labels=("OS" "Model" "Host" "Kernel" "Uptime" "Packages" "Shell" "DE" "WM" "Display" "CPU" "Memory" "GPU" "Disk" "Battery" "Local IP" "Locale")
values=("$os" "$model" "$host" "$kernel" "$uptime" "$packages" "$shell" "$de" "$wm" "$display_server" "$cpu" "$memory" "$gpu" "$disk" "$battery" "$local_ip" "$locale")
colors=("$C_OS" "$C_HW" "$C_HOST" "$C_CORE" "$C_TIME" "$C_PKG" "$C_ENV" "$C_DE" "$C_DE" "$C_ENV" "$C_CPU" "$C_MEM" "$C_GPU" "$C_DISK" "$C_BAT" "$C_NET" "$C_LOCALE")

for ((i = 0; i < ${#values[@]}; i++)); do
    v="${values[i]}"
    if [[ ${#v} -gt $VALUE_MAX ]]; then
        values[i]="${v:0:$((VALUE_MAX - 3))}..."
    fi
done

echo
printf "${BOX}"
printf "┌%*s┐\n" $((BOX_WIDTH-2)) "" | tr ' ' '-'
LEFT_PAD=4
while IFS= read -r line; do
    printf "%*s${AC}%s${NC}\n" "$LEFT_PAD" "" "$line"
done <<< "$BANNER"
echo
for ((i = 0; i < ${#labels[@]}; i++)); do
    printf "%*s${LBL}%-${LABEL_WIDTH}s${NC}: %b%s${NC}\n" "$LEFT_PAD" "" "${labels[i]}" "${colors[i]}" "${values[i]}"
done
echo
printf "${BOX}└%*s┘${NC}\n" $((BOX_WIDTH-2)) "" | tr ' ' '-'
echo